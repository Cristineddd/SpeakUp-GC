rules_version = '2';

/**
 * Firestore Security Rules - SpeakUp GC
 * 
 * Features:
 * - Soft delete support (filters out isDeleted records)
 * - Role-based access control
 * - Data consistency enforcement
 * 
 * Deploy: firebase deploy --only firestore:rules
 */

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================
    // HELPER FUNCTIONS
    // ========================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/representatives/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/representatives/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isHandler() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/representatives/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/representatives/$(request.auth.uid)).data.role in ['admin', 'handler'];
    }
    
    function isActiveUser() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isDeleted == false &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }
    
    function isNotDeleted() {
      return !('isDeleted' in resource.data) || resource.data.isDeleted == false;
    }
    
    // ========================================
    // COLLECTION RULES
    // ========================================
    
    // USERS COLLECTION
    match /users/{userId} {
      // Anyone can read active users
      allow read: if isAuthenticated() && (isNotDeleted() || isAdmin());
      
      // Users can create their own profile
      allow create: if isAuthenticated() && isOwner(userId);
      
      // Users can update their own profile, admins can update anyone
      allow update: if isOwner(userId) || isAdmin();
      
      // Only admins can delete (should use soft delete)
      allow delete: if isAdmin();
    }
    
    // REGISTERED USERS COLLECTION
    match /registeredUsers/{email} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    // COMPLAINTS COLLECTION
    match /complaints/{complaintId} {
      // Read: Owner, assigned handler, or admin
      // Only show non-deleted complaints (unless admin)
      allow read: if isAuthenticated() && 
                    (isNotDeleted() || isAdmin()) &&
                    (isOwner(resource.data.userId) || 
                     isOwner(resource.data.complainantId) ||
                     request.auth.uid == resource.data.handlerId ||
                     isAdmin());
      
      // Create: Any authenticated active user
      allow create: if isAuthenticated() && 
                      isActiveUser() &&
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.isDeleted == false;
      
      // Update: Admin or assigned handler (not the complainant after submission)
      allow update: if isAdmin() || 
                      (isHandler() && request.auth.uid == resource.data.handlerId);
      
      // Delete: Only admins (should use soft delete via update)
      allow delete: if isAdmin();
    }
    
    // REPRESENTATIVES COLLECTION
    match /representatives/{repId} {
      // Anyone authenticated can read (to see available handlers)
      allow read: if isAuthenticated();
      
      // Only admins can create/update/delete representatives
      allow create: if isAdmin();
      allow update: if isAdmin() || isOwner(resource.data.userId);
      allow delete: if isAdmin();
    }
    
    // CHAT ROOMS COLLECTION
    match /chatRooms/{roomId} {
      // Read: Only participants, and only non-deleted rooms
      allow read: if isAuthenticated() && 
                    request.auth.uid in resource.data.participantIds &&
                    (isNotDeleted() || isAdmin());
      
      // Create: Any authenticated user
      allow create: if isAuthenticated() && 
                      request.auth.uid in request.resource.data.participantIds;
      
      // Update: Participants can update
      allow update: if isAuthenticated() && 
                      request.auth.uid in resource.data.participantIds;
      
      // Delete: Only admins
      allow delete: if isAdmin();
    }
    
    // MESSAGES COLLECTION
    match /messages/{messageId} {
      // Read: Must be in the associated chat room
      allow read: if isAuthenticated();
      
      // Create: Any authenticated active user
      allow create: if isAuthenticated() && 
                      isActiveUser() &&
                      request.resource.data.senderId == request.auth.uid;
      
      // Update: Only sender or admin (for soft delete)
      allow update: if isOwner(resource.data.senderId) || isAdmin();
      
      // Delete: Only admins
      allow delete: if isAdmin();
    }
    
    // NOTIFICATIONS COLLECTION
    match /notifications/{notifId} {
      // Read: Only the user who the notification is for
      allow read: if isAuthenticated() && 
                    isOwner(resource.data.userId);
      
      // Create: System or admins
      allow create: if isAuthenticated();
      
      // Update: Owner can mark as read
      allow update: if isOwner(resource.data.userId);
      
      // Delete: Owner can delete their own notifications
      allow delete: if isOwner(resource.data.userId);
    }
    
    // CASE ACTIVITIES COLLECTION
    match /caseActivities/{activityId} {
      // Read: Anyone with access to the complaint
      allow read: if isAuthenticated();
      
      // Create: Handler or admin
      allow create: if isAuthenticated() && (isHandler() || isAdmin());
      
      // Update/Delete: Admin only
      allow update, delete: if isAdmin();
    }
    
    // ACTIVITY LOGS COLLECTION (Audit Trail)
    match /activityLogs/{logId} {
      // Read: Admin only
      allow read: if isAdmin();
      
      // Create: System can log
      allow create: if isAuthenticated();
      
      // Update/Delete: Never (immutable audit trail)
      allow update, delete: if false;
    }
    
    // NOTIFICATION PREFERENCES
    match /notificationPreferences/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // TYPING INDICATORS (Temporary Data)
    match /typingIndicators/{indicatorId} {
      allow read, write: if isAuthenticated();
    }
    
    // GROUP CHATS (if applicable)
    match /groupChats/{groupId} {
      allow read: if isAuthenticated() && 
                    request.auth.uid in resource.data.memberIds;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && 
                      request.auth.uid in resource.data.memberIds;
      allow delete: if isAdmin();
    }
    
    // PRESENCE (Online Status)
    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }
    
    // CASE NOTES
    match /caseNotes/{noteId} {
      allow read: if isAuthenticated() && (isHandler() || isAdmin());
      allow create: if isAuthenticated() && (isHandler() || isAdmin());
      allow update, delete: if isAdmin();
    }
    
    // COMPLIANCE REPORTS
    match /complianceReports/{reportId} {
      allow read, write: if isAdmin();
    }
    
    // REPORTS COLLECTION (Legacy - if still in use)
    match /reports/{reportId} {
      allow read: if isAuthenticated() && 
                    (isOwner(resource.data.userId) || isAdmin()) &&
                    (isNotDeleted() || isAdmin());
      allow create: if isAuthenticated() && isActiveUser();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ADMIN REPORTS COLLECTION (Legacy - if still in use)
    match /adminReports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    
    // ========================================
    // DATA VALIDATION
    // ========================================
    
    // Ensure soft delete fields are present on creation
    match /complaints/{complaintId} {
      allow create: if request.resource.data.keys().hasAll(['isDeleted', 'createdAt', 'status']);
    }
    
    match /chatRooms/{roomId} {
      allow create: if request.resource.data.keys().hasAll(['participantIds', 'complaintId']);
    }
    
    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasAll(['senderId', 'chatRoomId', 'content', 'createdAt']);
    }
  }
}
