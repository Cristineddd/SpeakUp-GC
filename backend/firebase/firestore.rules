rules_version = '2';

/**
 * Firestore Security Rules - SpeakUp GC
 * 
 * Features:
 * - Soft delete support (filters out isDeleted records)
 * - Role-based access control
 * - Data consistency enforcement
 * 
 * Deploy: firebase deploy --only firestore:rules
 */

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================
    // HELPER FUNCTIONS
    // ========================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isUserAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function hasStaffProfile() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/staffProfiles/$(request.auth.uid));
    }

    function staffProfile() {
      return get(/databases/$(database)/documents/staffProfiles/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isUserAdmin() ||
             (hasStaffProfile() && staffProfile().role == 'admin') ||
             (
               isAuthenticated() &&
               exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
             );
    }

    function isStaffMember() {
      return hasStaffProfile() &&
             staffProfile().role in ['admin', 'handler', 'codi'];
    }

    function isHandler() {
      return isStaffMember();
    }

    function isAssignedStaff() {
      return hasStaffProfile() && (
        resource.data.assignedTo == staffProfile().representativeId ||
        ('assignedToUserId' in resource.data && resource.data.assignedToUserId == request.auth.uid) ||
        request.auth.uid == resource.data.handlerId
      );
    }
    
    function isActiveUser() {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (!('isDeleted' in userData) || userData.isDeleted == false) &&
             (!('isActive' in userData) || userData.isActive == true);
    }
    
    function isNotDeleted() {
      return !('isDeleted' in resource.data) || resource.data.isDeleted == false;
    }

    function isComplainantOwner() {
      return isOwner(resource.data.userId) || isOwner(resource.data.complainantId);
    }

    // Allow get on missing docs (exists check) without treating it as permission denied
    function canReadCaseRecord() {
      return isAuthenticated() && (
        resource == null ||
        (
          (isNotDeleted() || isAdmin()) &&
          (isOwner(resource.data.userId) ||
           isOwner(resource.data.complainantId) ||
           isStaffMember() ||
           isAssignedStaff())
        )
      );
    }

    function isFollowUpRequestUpdate() {
      return isComplainantOwner() &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['followUpRequested', 'followUpRequestedAt', 'followUpRequestedBy']) &&
             request.resource.data.followUpRequested == true &&
             resource.data.followUpRequested != true;
    }

    function isCaseUnassigned() {
      return !('assignedTo' in resource.data) ||
             resource.data.assignedTo == null ||
             resource.data.assignedTo == '';
    }

    // Staff self-assign ("Take Case") on an unassigned complaint
    function isStaffTakeCaseUpdate() {
      return isStaffMember() &&
             isCaseUnassigned() &&
             request.resource.data.assignedTo == staffProfile().representativeId &&
             (
               !('assignedToUserId' in request.resource.data) ||
               request.resource.data.assignedToUserId == request.auth.uid
             ) &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly([
                 'assignedTo', 'assignedToName', 'assignedToRole', 'assignedToUserId',
                 'assignedAt', 'assignedBy', 'assignedByName', 'handlerHistory',
                 'updatedAt', 'lastUpdated'
               ]);
    }

    function isComplainantSubmissionUpdate() {
      return isOwner(resource.data.userId) &&
             resource.data.uploadStatus == 'uploading_files' &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['caseId', 'evidenceURLs', 'evidenceCount', 'uploadStatus', 'updatedAt', 'lastUpdated']);
    }

    function canReadChatRoom() {
      return request.auth.uid in resource.data.participantIds ||
             request.auth.uid == resource.data.complainantId ||
             request.auth.uid == resource.data.handlerId ||
             isStaffMember() ||
             isUserAdmin();
    }
    
    // ========================================
    // COLLECTION RULES
    // ========================================
    
    // USERS COLLECTION
    match /users/{userId} {
      // Owners can always get their own doc (including when missing — needed for
      // first-login ProfileSetup / Laya walkthrough). Others may read non-deleted users.
      allow get: if isOwner(userId) ||
                   (isAuthenticated() && resource != null && isNotDeleted()) ||
                   isAdmin();
      allow list: if isAuthenticated();
      
      // Users can create their own profile
      allow create: if isAuthenticated() && isOwner(userId);
      
      // Users can update their own profile, admins can update anyone
      allow update: if isOwner(userId) || isAdmin();
      
      // Only admins can delete (should use soft delete)
      allow delete: if isAdmin();
    }
    
    // REGISTERED USERS COLLECTION
    match /registeredUsers/{email} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    // CASE VIEWS (tracks which staff have reviewed/opened a case)
    match /caseViews/{viewId} {
      allow read: if isAuthenticated() &&
                    (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isAuthenticated() &&
                      isStaffMember() &&
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.keys().hasAll(['userId', 'caseId', 'viewedAt']);

      allow update: if isAuthenticated() &&
                      isStaffMember() &&
                      resource.data.userId == request.auth.uid &&
                      request.resource.data.userId == request.auth.uid;

      allow delete: if isAdmin();
    }

    // STAFF PROFILES (auth uid -> representative doc id + role, for security rules)
    match /staffProfiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create, update: if isAdmin() ||
        (isOwner(userId) &&
         request.resource.data.userId == userId &&
         request.resource.data.keys().hasAll(['representativeId', 'role']) &&
         exists(/databases/$(database)/documents/representatives/$(request.resource.data.representativeId)) &&
         get(/databases/$(database)/documents/representatives/$(request.resource.data.representativeId)).data.userId == userId);

      allow delete: if isAdmin();
    }

    // COMPLAINTS COLLECTION
    match /complaints/{complaintId} {
      // Read: Complainant, assigned staff, or any staff member (case queue)
      allow read: if canReadCaseRecord();
      
      // Create: Any authenticated active user
      allow create: if isAuthenticated() && 
                      isActiveUser() &&
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.isDeleted == false;
      
      // Update: Admin, assigned staff, staff take-case self-assign, complainant filing finalize, or follow-up request
      allow update: if isAdmin() ||
                      (isStaffMember() && isAssignedStaff()) ||
                      isStaffTakeCaseUpdate() ||
                      isComplainantSubmissionUpdate() ||
                      isFollowUpRequestUpdate();
      
      // Delete: Only admins (should use soft delete via update)
      allow delete: if isAdmin();
    }
    
    // REPRESENTATIVES COLLECTION
    match /representatives/{repId} {
      // Anyone authenticated can read (to see available handlers)
      allow read: if isAuthenticated();
      
      // Only admins can create/update/delete representatives
      allow create: if isAdmin();
      allow update: if isAdmin() || isOwner(resource.data.userId);
      allow delete: if isAdmin();
    }
    
    // CHAT ROOMS COLLECTION
    match /chatRooms/{roomId} {
      // Read: participants, complainant, assigned handler, staff, or platform admin
      allow read: if isAuthenticated() && 
                    (isNotDeleted() || isAdmin()) &&
                    (canReadChatRoom() || isAdmin());
      
      // Create: Any authenticated user
      allow create: if isAuthenticated() && 
                      request.auth.uid in request.resource.data.participantIds;
      
      // Update: Participants, staff joining, or handler assignment
      allow update: if isAuthenticated() && (
                      request.auth.uid in resource.data.participantIds ||
                      isAdmin() ||
                      (isStaffMember() &&
                       request.auth.uid in request.resource.data.participantIds) ||
                      (isStaffMember() &&
                       request.auth.uid == request.resource.data.handlerId)
                    );
      
      // Delete: Only admins
      allow delete: if isAdmin();
    }
    
    // MESSAGES COLLECTION
    match /messages/{messageId} {
      // Read: Must be in the associated chat room
      allow read: if isAuthenticated();
      
      // Create: Any authenticated active user
      allow create: if isAuthenticated() && 
                      isActiveUser() &&
                      request.resource.data.senderId == request.auth.uid;
      
      // Update: Sender, admin, or participant marking themselves as having read
      allow update: if isOwner(resource.data.senderId) ||
                      isAdmin() ||
                      (
                        request.auth.uid in request.resource.data.readBy &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['readBy', 'readAt', 'status'])
                      );
      
      // Delete: Only admins
      allow delete: if isAdmin();
    }
    
    // NOTIFICATIONS COLLECTION
    match /notifications/{notifId} {
      // Read: Owner or admin (admin needs this to cascade-delete users)
      allow read: if isAuthenticated() &&
                    (isOwner(resource.data.userId) || isAdmin());
      
      // Create: System or admins
      allow create: if isAuthenticated();
      
      // Update: Owner can mark as read; admin can update during cleanup
      allow update: if isOwner(resource.data.userId) || isAdmin();
      
      // Delete: Owner or admin (cascade user delete)
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
    
    // INTERNAL NOTES (case handler notes — used by admin user cleanup)
    match /internalNotes/{noteId} {
      allow read: if isAuthenticated() && (isHandler() || isAdmin());
      allow create: if isAuthenticated() && (isHandler() || isAdmin());
      allow update: if isAdmin() || isOwner(resource.data.createdBy);
      allow delete: if isAdmin() || isOwner(resource.data.createdBy);
    }
    
    // ACTIVITIES (legacy / general activity feed for user cleanup)
    match /activities/{activityId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin() || isStaffMember());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    
    // CASE ACTIVITIES COLLECTION
    match /caseActivities/{activityId} {
      // Read: Anyone with access to the complaint
      allow read: if isAuthenticated();
      
      // Create: Handler or admin
      allow create: if isAuthenticated() && (isHandler() || isAdmin());
      
      // Update/Delete: Admin only
      allow update, delete: if isAdmin();
    }
    
    // ACTIVITY LOGS COLLECTION (Audit Trail)
    match /activityLogs/{logId} {
      // Read: Admin only
      allow read: if isAdmin();
      
      // Create: System can log
      allow create: if isAuthenticated();
      
      // Update/Delete: Never (immutable audit trail)
      allow update, delete: if false;
    }
    
    // LOCATIONS (campus landmarks for complaint filing)
    match /locations/{locationId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // NOTIFICATION PREFERENCES
    match /notificationPreferences/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // FCM / PWA PUSH TOKENS
    match /fcmTokens/{tokenId} {
      allow read: if isAuthenticated() &&
                    (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() &&
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.keys().hasAll(['userId', 'token']);
      allow update: if isAuthenticated() &&
                      resource.data.userId == request.auth.uid &&
                      request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() &&
                      (isAdmin() || resource.data.userId == request.auth.uid);
    }
    
    // TYPING INDICATORS (Temporary Data)
    match /typingIndicators/{indicatorId} {
      allow read, write: if isAuthenticated();
    }
    
    // GROUP CHATS (if applicable)
    match /groupChats/{groupId} {
      allow read: if isAuthenticated() && 
                    request.auth.uid in resource.data.memberIds;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && 
                      request.auth.uid in resource.data.memberIds;
      allow delete: if isAdmin();
    }
    
    // PRESENCE (Online Status)
    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }
    
    // CASE NOTES
    match /caseNotes/{noteId} {
      allow read: if isAuthenticated() && (isHandler() || isAdmin());
      allow create: if isAuthenticated() && (isHandler() || isAdmin());
      allow update, delete: if isAdmin();
    }
    
    // COMPLIANCE REPORTS
    match /complianceReports/{reportId} {
      allow read, write: if isAdmin();
    }
    
    // SYSTEM SETTINGS (e.g. chatbot enable/disable toggle)
    match /systemSettings/{settingId} {
      // Read: Any authenticated user (complainants need this to know if the chatbot is enabled)
      allow read: if isAuthenticated();
      
      // Write: Admin only
      allow write: if isAdmin();
    }
    
    // SYSTEM AUDIT LOGS (immutable record of sensitive admin actions, e.g. settings changes)
    match /systemAuditLogs/{logId} {
      // Read: Admin only
      allow read: if isAdmin();
      
      // Create: Admin only
      allow create: if isAdmin();
      
      // Update/Delete: Never (immutable audit trail)
      allow update, delete: if false;
    }
    
    // REPORTS COLLECTION (Legacy - if still in use)
    match /reports/{reportId} {
      allow read: if canReadCaseRecord();
      allow create: if isAuthenticated() && isActiveUser();
      allow update: if isAdmin() ||
                      (isStaffMember() && isAssignedStaff()) ||
                      isStaffTakeCaseUpdate() ||
                      isFollowUpRequestUpdate();
      allow delete: if isAdmin();
    }
    
    // ADMIN REPORTS COLLECTION (Legacy - if still in use)
    match /adminReports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    
    // ========================================
    // DATA VALIDATION
    // ========================================
    
    // Ensure soft delete fields are present on creation
    match /complaints/{complaintId} {
      allow create: if request.resource.data.keys().hasAll(['isDeleted', 'createdAt', 'status']);
    }
    
    match /chatRooms/{roomId} {
      allow create: if request.resource.data.keys().hasAll(['participantIds', 'complaintId']);
    }
    
    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasAll(['senderId', 'chatRoomId', 'content', 'createdAt']);
    }
  }
}
